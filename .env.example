# Supabase -> Project Settings -> API
# Only the *anon / publishable* key belongs here. NEVER put the service_role key
# in any VITE_* variable: everything prefixed VITE_ is bundled into the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Branding (optional)
VITE_CAMPAIGN_NAME=Spin & Win
VITE_OUTLET_NAME=Our Outlet

# DEVELOPMENT ONLY: shows the "development OTP (1234)" notice in the UI.
# The real switch lives on the server (app_config.dev_otp_enabled).
# Must be false/absent in production - production builds fail if this is true.
VITE_DEV_OTP_ENABLED=true
# Only for a staging deployment that deliberately keeps the dev OTP:
# VITE_ALLOW_DEV_OTP_IN_PRODUCTION_BUILD=true

# Used only by `npm run qr` (public campaign URL, no trailing path needed)
CAMPAIGN_URL=https://your-campaign.vercel.app
